{
  "name": "deepzora-desktop-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint:hooks && pnpm check:waapi && pnpm check:scroll-writer && pnpm check:app-layers && node scripts/check-css-syntax.mjs src/styles.css src/components/ComposerWorkspaceContextBar.css src/components/RemoteConnectWizard.css src/components/ChatTranscript.css src/components/MCPInteractionCard.css src/components/SubagentDetails.css && node scripts/check-z-index-tokens.mjs src/styles.css src/components/ComposerWorkspaceContextBar.css src/components/RemoteConnectWizard.css && node scripts/check-theme-token-contract.mjs && tsc --noEmit && vite build && node scripts/check-bundle-budget.mjs",
    "build:electron": "node scripts/build-for-shell.mjs electron",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:scroll-writer": "node scripts/check-single-scroll-writer.mjs",
    "preview": "vite preview",
    "check:css": "node scripts/check-css-syntax.mjs src/styles.css src/components/ComposerWorkspaceContextBar.css src/components/RemoteConnectWizard.css src/components/MCPInteractionCard.css && node scripts/check-z-index-tokens.mjs src/styles.css src/components/ComposerWorkspaceContextBar.css src/components/RemoteConnectWizard.css && node scripts/check-theme-token-contract.mjs",
    "check:waapi": "node scripts/check-waapi-contract.mjs",
    "lint:hooks": "eslint \"src/**/*.{ts,tsx}\"",
    "test:todo-visibility": "node scripts/run-ci-tests.mjs --group todo-visibility",
    "typecheck": "tsc --noEmit",
    "test:terminal": "node scripts/run-ci-tests.mjs --group terminal",
    "test:usage-stats": "node scripts/run-ci-tests.mjs --group usage-stats",
    "test:task-monitor": "node scripts/run-ci-tests.mjs --group task-monitor",
    "test:mcp-app": "node scripts/run-ci-tests.mjs --group mcp-app",
    "test:workspace": "node scripts/run-ci-tests.mjs --group workspace",
    "test:settings-browser": "node bench/settings-layout.mjs",
    "test:sidebar-browser": "node bench/project-tree-sidebar.mjs",
    "test:settings-responsive": "node scripts/run-ci-tests.mjs --group settings-responsive",
    "test:stream": "node scripts/run-ci-tests.mjs --group stream",
    "test:motion": "node scripts/run-ci-tests.mjs --group motion",
    "test:ci-contract": "node scripts/run-ci-tests.mjs --group ci-contract",
    "test:motion-browser": "PLAYWRIGHT_BROWSERS_PATH=.pw-browsers node bench/approval-animation.mjs",
    "test:theme-browser": "PLAYWRIGHT_BROWSERS_PATH=.pw-browsers node bench/theme-surface-contract.mjs",
    "test:code-browser": "node bench/code-theme.mjs",
    "test:dock-responsive-browser": "node bench/responsive-dock.mjs",
    "test:diagnostics": "node scripts/run-ci-tests.mjs --group diagnostics",
    "test:transcript": "node scripts/run-ci-tests.mjs --group transcript",
    "test:session-export-browser": "node bench/session-export.mjs",
    "test:session-loading-browser": "node bench/session-loading.mjs && node bench/manual-creation.mjs && node bench/manual-creation-recovery.mjs",
    "test:maintenance-browser": "node bench/maintenance-submit.mjs",
    "test:turn-outline-browser": "node bench/turn-outline.mjs",
    "test:turn-outline-electron": "node bench/turn-outline.mjs --electron",
    "test:transcript-browser": "PLAYWRIGHT_BROWSERS_PATH=.pw-browsers CHAT_BROWSER=chromium node bench/chat-transcript.mjs",
    "test:transcript-reader-browser": "PLAYWRIGHT_BROWSERS_PATH=.pw-browsers CHAT_BROWSER=chromium node bench/chat-transcript.mjs",
    "test:transcript-electron": "node bench/transcript-layout.mjs --electron",
    "test:submission-browser": "node bench/submission-handoff.mjs",
    "test:submission-electron": "node bench/submission-handoff.mjs --electron",
    "test:dock-electron": "node bench/dock-file-navigation.mjs --electron",
    "test:composer-menu-viewport": "node scripts/run-ci-tests.mjs --group composer-menu-viewport",
    "test:composer": "node scripts/run-ci-tests.mjs --group composer",
    "test:composer-browser": "node bench/composer-transcript-stability.mjs",
    "test:popover-browser": "node bench/anchored-popover-lifecycle.mjs",
    "test:popover-electron": "node bench/anchored-popover-lifecycle.mjs --electron",
    "test": "node scripts/run-ci-tests.mjs",
    "test:remote": "node scripts/run-ci-tests.mjs --group remote",
    "test:performance": "node scripts/run-ci-tests.mjs --group performance",
    "test:bench": "PLAYWRIGHT_BROWSERS_PATH=.pw-browsers node bench/run.mjs",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:isolated-worktree": "tsx src/__tests__/isolated-worktree.test.ts",
    "test:updater": "node scripts/run-ci-tests.mjs --group updater",
    "test:window-state": "node scripts/run-ci-tests.mjs --group window-state",
    "test:all": "node scripts/run-ci-tests.mjs",
    "test:app-lifecycle": "node scripts/run-ci-tests.mjs --group app-lifecycle",
    "test:app-browser": "PLAYWRIGHT_BROWSERS_PATH=.pw-browsers node bench/app-browser.mjs && node bench/dock-view-state.mjs && node bench/dock-file-navigation.mjs && node bench/runtime-state.mjs && node bench/attention-notifications.mjs && pnpm test:session-loading-browser",
    "test:app-memory": "PLAYWRIGHT_BROWSERS_PATH=.pw-browsers node bench/app-memory.mjs",
    "check:app-layers": "node scripts/check-app-entry-contract.mjs && node scripts/check-app-layers.test.mjs && node scripts/check-app-layers.mjs && node scripts/check-desktop-host-boundary.mjs",
    "test:chat": "pnpm test:transcript",
    "test:chat-file-browser": "PLAYWRIGHT_BROWSERS_PATH=.pw-browsers node bench/chat-file-reference.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "anser": "^2.3.5",
    "hast-util-to-jsx-runtime": "2.3.6",
    "highlight.js": "^11.12.0",
    "html-url-attributes": "3.0.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "mermaid": "^12.1.0",
    "qrcode.react": "^4.2.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "6.0.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "decode-named-character-reference": "^1.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "jsdom": "^30.1.2",
    "mdast-util-math": "^3.0.0",
    "playwright": "^1.64.0",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.3"
  },
  "overrides": {
    "dompurify": "3.4.16",
    "katex": "0.19.0",
    "mdast-util-gfm-autolink-literal": "2.0.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10 <11"
  }
}
