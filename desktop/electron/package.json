{
  "name": "deepzora-desktop-shell",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "description": "Electron shell hosting the Deepzora Desktop UI over the desktop host protocol",
  "type": "module",
  "main": "dist/main.cjs",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json",
    "test": "node scripts/build-browser-page.mjs && node --import tsx --test \"src/**/*.test.ts\"",
    "test:graphics-recovery": "node scripts/graphics-recovery-smoke.mjs",
    "test:attachments": "node scripts/attachment-smoke.mjs",
    "test:agent-presets": "node scripts/agent-presets-smoke.mjs",
    "start": "node scripts/build.mjs && node scripts/start.mjs",
    "dev": "node scripts/build.mjs && node scripts/start.mjs --dev",
    "smoke": "node scripts/build.mjs && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "^26.6.4",
    "electron": "44.7.0",
    "esbuild": "^0.28.2",
    "jsdom": "30.1.2",
    "playwright": "1.62.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10 <11"
  }
}
